# Java does not automatically source this file. Native dev uses private .runtime/auth.env.
# Provide two distinct random values of at least 32 characters; never commit real keys.
CLIMATE_READ_KEY=
CLIMATE_ADMIN_KEY=
CLIMATE_PLATFORM_ADMIN_PASSWORD=
CLIMATE_PLATFORM_INBOX_ENABLED=false
CLIMATE_INCREMENTAL_ENABLED=false
CLIMATE_INCREMENTAL_DIRECTORY=data/incremental
CLIMATE_INCREMENTAL_DELAY_MS=60000
CLIMATE_INCREMENTAL_INITIAL_DELAY_MS=30000
CLIMATE_INCREMENTAL_MIN_AGE_MS=30000
